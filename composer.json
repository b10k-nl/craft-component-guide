{
    "name": "b10k/craft-component-guide",
    "description": "Let editors see and add page blocks without asking a dev — a component library and block previews for Craft CMS, inside the control panel.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "components",
        "component library",
        "design system",
        "storybook",
        "twig",
        "matrix",
        "matrix blocks",
        "page builder",
        "blocks",
        "block preview",
        "live preview",
        "authoring experience"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "b10k",
            "homepage": "https://b10k.nl"
        }
    ],
    "support": {
        "docs": "https://github.com/b10k-nl/craft-component-guide/blob/main/README.md",
        "issues": "https://github.com/b10k-nl/craft-component-guide/issues",
        "source": "https://github.com/b10k-nl/craft-component-guide"
    },
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "b10k\\componentguide\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "b10k\\componentguide\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "component-guide",
        "name": "Component Guide",
        "developer": "b10k",
        "developerUrl": "https://b10k.nl",
        "documentationUrl": "https://github.com/b10k-nl/craft-component-guide/blob/main/README.md",
        "changelogUrl": "https://github.com/b10k-nl/craft-component-guide/blob/main/CHANGELOG.md",
        "class": "b10k\\componentguide\\Plugin"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
