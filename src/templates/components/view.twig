{% extends "_layouts/cp" %}

{% set title = component.title %}
{% set docTitle = component.title ~ " · " ~ "Component Guide"|t('component-guide') %}

{% set crumbs = [
    { label: "Component Guide"|t('component-guide'), url: cpUrl('component-guide') },
    { label: component.title, url: cpUrl('component-guide/components/' ~ component.id) },
] %}

{% do view.registerAssetBundle("b10k\\componentguide\\assetbundles\\ComponentGuideAsset") %}

{% block sidebar %}
    {% include "component-guide/components/_tree" with {
        grouped: grouped,
        reviewEnabled: reviewEnabled ?? false,
        reviewStates: reviewStates ?? {},
        reviewsNew: reviewsNew ?? 0,
        reviewsTotal: reviewsTotal ?? 0,
        canClearReviews: canClearReviews ?? false,
        reviewsExportedOn: reviewsExportedOn ?? null,
        contractErrors: contractErrors,
        pro: pro,
        current: component,
        story: story,
    } only %}
{% endblock %}


{% block content %}
    <div class="cg-detail">
        <header class="cg-detail__header">
            <div class="cg-detail__meta">
                <span class="cg-chip">{{ component.effectiveGroup }}</span>
                {% if component.status %}
                    <span class="cg-chip cg-chip--status cg-chip--{{ component.status|lower|replace({' ': '-'}) }}"
                          data-cg-status-chip>{{ component.status }}</span>
                {% endif %}
                <span class="cg-detail__path code">{{ component.templatePath }}</span>
                <span data-cg-gallery-chip{% if not readyForEditors %} hidden{% endif %}>
                    <span class="cg-chip cg-chip--gallery">{{ "in gallery"|t('component-guide') }}</span>
                </span>
                {# The page you are on when you decide. The index toggle is for
                   the obvious ones; this is for the ones you had to look at. #}
                {% if canToggleStatus and component.status in ['draft', 'stable'] %}
                    <button type="button" class="btn cg-detail__status"
                            data-cg-status-toggle
                            data-component-id="{{ component.id }}"
                            data-status="{{ component.status }}"
                            data-label-stable="{{ "Mark stable"|t('component-guide') }}"
                            data-label-draft="{{ "Back to draft"|t('component-guide') }}"
                            data-error-status="{{ "Could not change the status."|t('component-guide') }}">
                        {{ component.status == 'draft'
                            ? "Mark stable"|t('component-guide')
                            : "Back to draft"|t('component-guide') }}
                    </button>
                {% endif %}
            </div>
            {% if entryTypeName %}
                {# The other half of this component's life, which is otherwise
                   invisible from the control panel. Both sentences are on the
                   page, so the status toggle can swap them without a reload. #}
                {% set unavailable = "Marked “{status}”, so the blocks gallery shows editors the “{name}” block as unavailable." %}
                <p class="cg-detail__editors light" data-cg-editors-ready{% if not readyForEditors %} hidden{% endif %}>
                    {{ "Editors add this as the “{name}” block, from the blocks gallery on any page-builder field — with this story's content already filled in."|t('component-guide', { name: entryTypeName }) }}
                </p>
                <p class="cg-detail__editors light" data-cg-editors-unavailable
                   data-template="{{ unavailable|t('component-guide', { status: '{status}', name: entryTypeName }) }}"
                   {%- if readyForEditors or not component.status or component.status == 'stable' %} hidden{% endif %}>
                    {{ unavailable|t('component-guide', { status: component.status, name: entryTypeName }) }}
                </p>
            {% endif %}
            {% if component.description %}
                <p class="cg-detail__desc">{{ component.description }}</p>
            {% endif %}
        </header>

        {% include "component-guide/components/_errors" with { errors: component.errors } only %}

        {# The contract mismatch the index card marks with ≠, said in full:
           nothing is broken, but a card promises what no editor can produce. #}
        {% set contract = contractErrors[component.id] ?? [] %}
        {% if contract is not empty %}
            <div class="cg-contract">
                {% for error in contract %}
                    <div class="cg-contract__item">
                        <span class="cg-badge cg-badge--contract" aria-hidden="true">&ne;</span>
                        <div>
                            <div class="cg-contract__msg">{{ error.message }}</div>
                            {% if error.recommendation() %}
                                <div class="light">{{ error.recommendation() }}</div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if component.stories is empty %}
            <div class="cg-empty zilch">
                <p>{{ "This component has no valid stories."|t('component-guide') }}</p>
            </div>
        {% else %}
            <div class="cg-layout cg-layout--single">
                <div class="cg-main">
                    <div class="cg-preview">
                        <div class="cg-preview__bar">
                            <span class="cg-preview__devices" role="group" aria-label="{{ 'Preview device'|t('component-guide') }}">
                                <button type="button" class="cg-dev cg-dev--desktop is-active" data-cg-device="desktop" title="{{ 'Desktop'|t('component-guide') }}" aria-label="{{ 'Desktop'|t('component-guide') }}"></button>
                                <button type="button" class="cg-dev cg-dev--tablet" data-cg-device="tablet" title="{{ 'Tablet'|t('component-guide') }}" aria-label="{{ 'Tablet'|t('component-guide') }}"></button>
                                <button type="button" class="cg-dev cg-dev--phone" data-cg-device="phone" title="{{ 'Phone'|t('component-guide') }}" aria-label="{{ 'Phone'|t('component-guide') }}"></button>
                            </span>
                            <span class="cg-preview__actions">
                                <span class="cg-preview__width light" data-cg-width></span>
                                <button type="button" class="btn" data-icon="rotate-left" data-cg-rotate hidden>{{ "Rotate"|t('component-guide') }}</button>
                                <button type="button" class="btn" data-icon="arrows-rotate" data-cg-refresh>{{ "Refresh"|t('component-guide') }}</button>
                                <a class="btn" data-icon="share" href="{{ previewUrl }}" target="_blank" rel="noopener" data-cg-open-tab>{{ "Open in new tab"|t('component-guide') }}</a>
                            </span>
                        </div>

                        {% if enableIframePreview %}
                            {# Device preview, mirroring Craft's own Live Preview: the iframe
                               holder is sized to exact device pixels and the whole thing is
                               transform:scale()'d to fit — the iframe stays width/height:100%,
                               which is the one layout Chrome composites reliably. JS builds the
                               device container + SVG bezel mask inside the stage (see
                               component-guide.js). #}
                            <div class="cg-preview__frame"
                                 data-cg-default-device="{{ story.viewport }}"
                                 data-cg-src="{{ previewUrl }}"
                                 data-cg-title="{{ component.title }} — {{ story.title }}">
                                <div class="cg-preview__loading">{{ "Loading…"|t('component-guide') }}</div>
                                <div class="cg-preview__stage" data-cg-stage{% if story.background %} style="background: {{ story.background }};"{% endif %}></div>
                            </div>
                        {% else %}
                            <p class="light cg-preview__note">
                                {{ "Iframe preview is disabled. "|t('component-guide') }}
                                <a href="{{ previewUrl }}" target="_blank" rel="noopener">{{ "Open the preview"|t('component-guide') }}</a>.
                            </p>
                        {% endif %}
                    </div>

                    {#
                        Under the preview, one set of tabs for the story — what
                        changes it (Controls), what it is, its args, how to use
                        it — Craft's own tabs, the last one chosen remembered in
                        this browser. Client review sits below them, always
                        open: values tried in Controls and the decision belong
                        on screen together.
                    #}
                    {% set hasAbout = story.description or story.tags is not empty or story.viewport %}
                    {% set tabs = {} %}
                    {% if enableIframePreview %}
                        {% set tabs = tabs|merge({ 'cg-tab-controls': { label: 'Controls'|t('component-guide'), url: '#cg-tab-controls' } }) %}
                    {% endif %}
                    {% if hasAbout %}
                        {% set tabs = tabs|merge({ 'cg-tab-about': { label: 'About this story'|t('component-guide'), url: '#cg-tab-about' } }) %}
                    {% endif %}
                    {% set tabs = tabs|merge({ 'cg-tab-args': { label: 'Story args'|t('component-guide'), url: '#cg-tab-args' } }) %}
                    {% if snippet %}
                        {% set tabs = tabs|merge({ 'cg-tab-usage': { label: 'Twig usage'|t('component-guide'), url: '#cg-tab-usage' } }) %}
                    {% endif %}
                    {% set firstTab = tabs|keys|first %}

                    <div class="pane cg-story-tabs" data-cg-tabs data-msg-changed="{{ 'changed'|t('component-guide') }}">
                        <header class="pane-header">
                            {% include '_includes/tabs' with {
                                tabs: tabs,
                                tablistLabel: 'Story'|t('component-guide'),
                            } %}
                            {# Folds the panes away — the tabs stay — so the preview
                               and the client review below fit on one screen. #}
                            <button type="button" class="cg-tabs__toggle" data-cg-tabs-toggle
                                    aria-expanded="true"
                                    data-label-hide="{{ 'Collapse'|t('component-guide') }}"
                                    data-label-show="{{ 'Expand'|t('component-guide') }}"
                                    title="{{ 'Collapse'|t('component-guide') }}"
                                    aria-label="{{ 'Collapse'|t('component-guide') }}"></button>
                        </header>

                        {% if enableIframePreview %}
                            <div id="cg-tab-controls" class="cg-tabpane{{ firstTab != 'cg-tab-controls' ? ' hidden' }}" role="tabpanel" aria-labelledby="tab-cg-tab-controls">
                                {% include "component-guide/components/_controls" with {
                                    controls: controls,
                                    component: component,
                                    story: story,
                                    previewUrl: previewUrl,
                                } only %}
                            </div>
                        {% endif %}

                        {% if hasAbout %}
                            <div id="cg-tab-about" class="cg-tabpane{{ firstTab != 'cg-tab-about' ? ' hidden' }}" role="tabpanel" aria-labelledby="tab-cg-tab-about">
                                {% if story.description %}
                                    <p>{{ story.description }}</p>
                                {% endif %}
                                {% if story.tags is not empty %}
                                    <div class="cg-panel__row">
                                        <span class="light">{{ "Tags"|t('component-guide') }}</span>
                                        <div class="cg-tags">
                                            {% for tag in story.tags %}<span class="cg-chip">{{ tag }}</span>{% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                                {% if story.viewport %}
                                    <div class="cg-panel__row">
                                        <span class="light">{{ "Viewport"|t('component-guide') }}</span>
                                        <span class="code">{{ story.viewport }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div id="cg-tab-args" class="cg-tabpane{{ firstTab != 'cg-tab-args' ? ' hidden' }}" role="tabpanel" aria-labelledby="tab-cg-tab-args">
                            <pre class="cg-code">{{ story.args|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                        </div>

                        {% if snippet %}
                            <div id="cg-tab-usage" class="cg-tabpane hidden" role="tabpanel" aria-labelledby="tab-cg-tab-usage">
                                <div class="cg-tabpane__actions">
                                    <button type="button" class="btn" data-icon="clipboard" data-cg-copy>{{ "Copy"|t('component-guide') }}</button>
                                </div>
                                <pre class="cg-code" data-cg-snippet>{{ snippet }}</pre>
                            </div>
                        {% endif %}
                    </div>

                    {# Only with client review on (Pro, turned on in the settings):
                       otherwise not a word about it, on staging or production. #}
                    {% if reviewEnabled %}
                        {% include "component-guide/components/_review" with {
                            component: component,
                            story: story,
                            storyState: reviewStates[component.id].stories[story.id] ?? null,
                            history: reviewHistory,
                            canReview: canReview,
                            reviewsOnBlock: reviewsOnBlock,
                            canClearReviews: canClearReviews,
                        } only %}
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
