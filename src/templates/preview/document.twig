{% apply spaceless %}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ component.title }} — {{ story.title }}</title>
    {% for href in previewCss %}
        <link rel="stylesheet" href="{{ href }}">
    {% endfor %}
    <style>
        html, body { margin: 0; padding: 0; }
        body { padding: 16px; box-sizing: border-box; {% if story.background %}background: {{ story.background }};{% endif %} }
        .cg-render-error { font-family: system-ui, sans-serif; color: #9a1f11; background: #fcebea; border: 1px solid #f3c1bd; border-radius: 6px; padding: 16px; }
        .cg-render-error pre { white-space: pre-wrap; overflow-x: auto; font-size: 12px; color: #444; }
        .cg-render-empty { font-family: system-ui, sans-serif; color: #6b5a2b; background: #fdf6e3; border: 1px solid #f0e0b0; border-radius: 6px; padding: 16px; line-height: 1.5; }
        .cg-render-empty code { background: rgba(0,0,0,.06); border-radius: 3px; padding: 1px 4px; }
    </style>
    <script>
        // Placeholder photos come from an external service (@image tokens), so a
        // locked-down or offline environment would show broken images — which
        // reads as “the plugin is broken”. Swap any failed image for an inline
        // SVG of the same box instead. Capture phase: <img> error doesn't bubble.
        document.addEventListener('error', function (e) {
            var img = e.target;
            if (!img || img.tagName !== 'IMG' || img.dataset.cgFallback) { return; }
            img.dataset.cgFallback = '1';
            var w = img.naturalWidth || img.width || 800;
            var h = img.naturalHeight || img.height || 600;
            img.src = 'data:image/svg+xml,' + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" width="' + w + '" height="' + h + '">'
                + '<rect width="100%" height="100%" fill="#e2e8f0"/>'
                + '<path d="M0 ' + h + ' ' + (w * 0.3) + ' ' + (h * 0.45) + 'l' + (w * 0.18) + ' ' + (h * 0.3)
                + ' ' + (w * 0.15) + ' -' + (h * 0.25) + ' ' + (w * 0.37) + ' ' + (h * 0.5) + 'z" fill="#94a3b8"/>'
                + '<circle cx="' + (w * 0.78) + '" cy="' + (h * 0.24) + '" r="' + (Math.min(w, h) * 0.12) + '" fill="#cbd5e1"/>'
                + '</svg>'
            );
        }, true);
    </script>
    {{ (previewHead ?? '')|raw }}
</head>
<body>
{% endapply %}
{% if result.success %}
    {% if result.html|trim is empty %}
        {# A blank iframe reads as “broken” — name the likely cause instead.
           Usually the whole template sits behind an {% if %} on values the
           story doesn't supply, or it reads Craft data (block/entry) itself. #}
        <div class="cg-render-empty">
            <strong>{{ "This story rendered nothing."|t('component-guide') }}</strong>
            <p>{{ "The template produced no output with these args — usually because its markup sits behind a condition on values the story doesn't provide, or because the template reads Craft data itself (e.g. {block} or {entry}), which a story can't supply."|t('component-guide', {
                block: '<code>block</code>',
                entry: '<code>entry</code>',
            })|raw }}</p>
            <p>{{ "Check the story's args against the template, or move the markup into a presentational partial that takes plain values."|t('component-guide') }}</p>
        </div>
    {% else %}
        {{ result.html|raw }}
    {% endif %}
{% else %}
    <div class="cg-render-error">
        <strong>{{ "Render error"|t('component-guide') }}</strong>
        <p>{{ result.error }}</p>
        {% if devMode and result.details %}
            <pre>{{ result.details }}</pre>
        {% endif %}
    </div>
{% endif %}
{% for src in previewJs %}
    <script src="{{ src }}"></script>
{% endfor %}
</body>
</html>
