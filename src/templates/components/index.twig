{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Component Guide"|t('component-guide') %}
{% set docTitle = title %}

{% do view.registerAssetBundle("b10k\\componentguide\\assetbundles\\ComponentGuideAsset") %}

{% block content %}
    <p class="cg-intro light">
        {{ "A browser for reusable Twig components and their story states, discovered from your templates directory."|t('component-guide') }}
        {# The editor half is invisible from this page, so the page has to name
           it — and name what the editor actually gets, not just that a gallery
           exists. Without that, this reads as an index the developer could have
           generated themselves, while the half worth paying for happens
           somewhere they never look. In Lite the gallery opens but the click
           does not insert, so “adds it with one click” would be a lie there. #}
        {% if pro %}
            {{ "A component with a story also becomes a card in the blocks gallery — where an editor, on any entry with a matching page-builder field, adds it with one click, prefilled from the story."|t('component-guide') }}
        {% else %}
            {{ "A component with a story also becomes a card in the blocks gallery — where an editor, on any entry with a matching page-builder field, sees it with the same preview you see here. Adding from the gallery is a Pro feature."|t('component-guide') }}
        {% endif %}
    </p>

    {% include "component-guide/components/_errors" with { errors: scanErrors } only %}

    <div class="cg-toolbar">
        <div class="cg-stats">
            <span class="cg-stat">
                <strong>{{ componentCount }}</strong>
                {{ (componentCount == 1 ? "component" : "components")|t('component-guide') }}
            </span>
            <span class="cg-stat">
                <strong>{{ storyCount }}</strong>
                {{ (storyCount == 1 ? "story" : "stories")|t('component-guide') }}
            </span>
            {% if undocumentedCount is defined and undocumentedCount > 0 %}
                <span class="cg-stat">
                    <strong>{{ undocumentedCount }}</strong>
                    {{ "without stories"|t('component-guide') }}
                </span>
            {% endif %}
            {# Only where the guide is actually feeding a page builder. On a
               project whose components are not Matrix blocks at all, a
               permanent “0 ready for editors” would read as a fault. #}
            {% if galleryMatchedCount > 0 %}
                <span class="cg-stat cg-stat--editors"
                      title="{{ "Documented and stable, matched to an entry type — editors can add these from the blocks gallery, prefilled with the story's content."|t('component-guide') }}">
                    <strong data-cg-ready-count>{{ galleryReadyCount }}</strong>
                    {{ "ready for editors"|t('component-guide') }}
                </span>
            {% endif %}
        </div>

        {% if componentCount > 0 %}
            {# Filter options are built from what is actually on the page, not
               from a taxonomy we invent: a status is whatever the story file
               says, and the two synthetic buckets cover the states a story
               cannot express — no status written, and no story at all. Each
               select is drawn only when it has something to choose between; a
               lone “All groups” on a one-group project is a control that does
               nothing. #}
            {% set statusBuckets = [] %}
            {% for groupComponents in grouped %}
                {% for component in groupComponents %}
                    {% set bucket = not component.isDocumented ? '__nostory' : (component.status ?: '__nostatus') %}
                    {% if bucket not in statusBuckets %}
                        {% set statusBuckets = statusBuckets|merge([bucket]) %}
                    {% endif %}
                {% endfor %}
            {% endfor %}

            <div class="cg-toolbar__tools">
                {% if grouped|length > 1 or statusBuckets is not empty %}
                    <div class="cg-filters"
                         data-label-nostory="{{ "No story"|t('component-guide') }}"
                         data-label-nostatus="{{ "No status"|t('component-guide') }}">
                        {% if grouped|length > 1 %}
                            {% set groupOptions = [{ label: "All groups"|t('component-guide'), value: '' }] %}
                            {% for groupName in grouped|keys %}
                                {% set groupOptions = groupOptions|merge([{ label: groupName, value: groupName }]) %}
                            {% endfor %}
                            {{ forms.select({
                                id: 'cg-filter-group',
                                options: groupOptions,
                                label: "Group"|t('component-guide'),
                                labelHidden: true,
                            }) }}
                        {% endif %}

                        {# Only the “all” option is rendered here. The rest are built in
                           the browser from the cards actually on the page, and rebuilt
                           after every status toggle — the toggle moves a component
                           between statuses over AJAX, so a list fixed at render time
                           would either go stale or, if we pre-empted it with every
                           status the plugin can write, offer choices that match nothing.
                           The whole control hides itself when there is only one status
                           to choose between. #}
                        {% if statusBuckets is not empty %}
                            {{ forms.select({
                                id: 'cg-filter-status',
                                options: [{ label: "All statuses"|t('component-guide'), value: '' }],
                                label: "Status"|t('component-guide'),
                                labelHidden: true,
                            }) }}
                        {% endif %}
                    </div>
                {% endif %}

                <div class="cg-search">
                    {{ forms.text({
                        id: 'cg-search',
                        placeholder: "Search components…"|t('component-guide'),
                        autofocus: true,
                    }) }}
                </div>
            </div>
        {% endif %}
    </div>

    {% if componentCount == 0 %}
        {% set scanRoot = 'templates/' ~ (settings.componentPath ? settings.componentPath ~ '/' : '') %}
        <div class="cg-onboarding">
            <h2 class="cg-onboarding__title">{{ "No components yet — here's how to add them"|t('component-guide') }}</h2>
            <p class="light">
                {{ "The guide discovers components inside {path} — nothing is registered by hand."|t('component-guide', {
                    path: '<code>' ~ scanRoot ~ '</code>',
                })|raw }}
            </p>

            <ol class="cg-onboarding__steps">
                <li>
                    <strong>{{ "Fastest: list what you already have."|t('component-guide') }}</strong>
                    <p class="light">
                        {{ "Drop a marker file into the folder your components or page-builder blocks live in — every Twig template in it (and its subfolders) shows up straight away, no story files needed."|t('component-guide') }}
                    </p>
                    <div class="cg-code">{{ scanRoot }}&lt;your-blocks-folder&gt;/{{ markerFiles|first }}</div>
                    <p class="light cg-onboarding__hint">
                        {{ "Any of these names work: {names}. Its first heading becomes the group name, the text below it the group description."|t('component-guide', {
                            names: markerFiles|join(', '),
                        }) }}
                    </p>
                </li>
                <li>
                    <strong>{{ "Then: add a story — previews here, a gallery card there."|t('component-guide') }}</strong>
                    <p class="light">
                        {{ "A story file next to a template defines the props to render it with. Listed components get an “Add story” button that writes a first draft for you."|t('component-guide') }}
                    </p>
                    <p class="light cg-onboarding__hint">
                        {{ "Where the template's name matches a Matrix entry type handle, that same story gives editors a card in the blocks gallery — a real preview they click to add, prefilled with the story's content."|t('component-guide') }}
                    </p>
                    {# A library that already exists is the normal case, and doing it
                       a button at a time is the wrong shape for it. The recipe ships
                       in the package, so this is a path, not a promise. #}
                    <p class="light cg-onboarding__hint">
                        {{ "For a folder that already has dozens of templates: {file} in this plugin is a recipe any coding agent can follow to draft them all in one pass, for you to review here."|t('component-guide', {
                            file: '<code>AGENT-SETUP.md</code>',
                        })|raw }}
                    </p>
                    <div class="cg-code">Read AGENT-SETUP.md in vendor/b10k/craft-component-guide and follow it.</div>
                    {# Flush-left on purpose: .cg-code is pre-wrap, so template
                       indentation would show up in the output. #}
                    <div class="cg-code">hero.twig
hero{{ settings.twigStorySuffix() }}</div>
                </li>
                <li>
                    <strong>{{ "If your templates live elsewhere"|t('component-guide') }}</strong>
                    <p class="light">
                        {{ "Point the guide at the right folder, and add your compiled front-end CSS so previews look like the real site."|t('component-guide') }}
                    </p>
                    <a class="btn" href="{{ cpUrl('settings/plugins/component-guide') }}">{{ "Open settings"|t('component-guide') }}</a>
                </li>
            </ol>
        </div>
    {% else %}
        {% if not canScaffold and undocumentedCount %}
            {# Craft-style environment notice: an absent button is a mystery,
               a stated reason is information. #}
            <p class="cg-hint cg-hint--locked">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path fill="currentColor" d="M11 6V4.5a3 3 0 1 0-6 0V6H4v8h8V6h-1zM6 4.5a2 2 0 1 1 4 0V6H6V4.5z"/>
                </svg>
                {# Two different closed doors, two different next steps. #}
                {% if scaffoldBlockedReason == 'read-only' %}
                    {{ "The templates directory is read-only on this environment, so story files can’t be created here. Scaffold them locally and commit."|t('component-guide') }}
                {% else %}
                    {{ "Story scaffolding isn’t permitted in this environment."|t('component-guide') }}
                {% endif %}
            </p>
        {% endif %}

        {# Always in the DOM, hidden when there is nothing to report: the JS
           repaints it after a status change, and a banner that does not exist
           cannot be repainted. The sentence carries no count on purpose —
           the list below is the count, and a number in the text would mean
           composing a pluralised string in JS. #}
        <div class="cg-hint cg-hint--writes" data-cg-writes{% if cpWrites is empty %} hidden{% endif %}
             data-word-scaffold="{{ "story scaffolded"|t('component-guide') }}"
             data-word-status="{{ "status changed"|t('component-guide') }}"
             data-error-status="{{ "Could not change the status."|t('component-guide') }}"
             data-error-reviewed="{{ "Could not clear the notice."|t('component-guide') }}">
            <div class="cg-hint__row">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path fill="currentColor" d="M3 2h7l3 3v9H3V2zm1 1v10h8V6H9V3H4zm2 5h5v1H6V8zm0 2h5v1H6v-1z"/>
                </svg>
                <strong>{{ "Component Guide changed these files from the control panel, and the changes are still on disk."|t('component-guide') }}</strong>
                <span class="light">{{ "Review the diff and commit."|t('component-guide') }}</span>
                <span class="cg-hint__action">
                    <button type="button" class="btn small" data-cg-reviewed>{{ "Reviewed"|t('component-guide') }}</button>
                </span>
            </div>
            <ul class="cg-writes" data-cg-writes-list>
                {% for write in cpWrites %}
                    <li>
                        <code>{{ write.file }}</code>
                        <span class="light">
                            {{ write.action == 'scaffold' ? "story scaffolded"|t('component-guide') : "status changed"|t('component-guide') }}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </div>

        {% if canScaffold and undocumentedCount > 3 %}
            {# The onboarding panel only shows at zero components, so it is gone by
               the time this matters: a folder listed via a marker file, dozens of
               cards, and an “Add story” button on each. Saying it once here is the
               difference between a feature and a secret. #}
            <div class="cg-hint cg-hint--agent">
                <div class="cg-hint__row">
                    <strong>
                        {{ "{count} components have no story yet."|t('component-guide', { count: undocumentedCount }) }}
                    </strong>
                    <span class="light">
                        {{ "Rather than one button at a time, {file} in this plugin is a recipe any coding agent can follow to draft them all at once — everything it writes is a draft for you to review here."|t('component-guide', {
                            file: '<code>AGENT-SETUP.md</code>',
                        })|raw }}
                    </span>
                </div>
                <div class="cg-code">Read AGENT-SETUP.md in vendor/b10k/craft-component-guide and follow it.</div>
            </div>
        {% endif %}

        {% if settings.previewCss is empty and settings.previewTemplate is empty %}
            {# Unstyled previews read as “broken plugin” — say why before they conclude that.
               A configured previewTemplate counts as styling too (e.g. Vite asset tags). #}
            <p class="cg-hint">
                {{ "Previews render without your site's CSS."|t('component-guide') }}
                <a href="{{ cpUrl('settings/plugins/component-guide') }}">{{ "Add your compiled stylesheet"|t('component-guide') }}</a>
                {{ "to see components as they look on the front end."|t('component-guide') }}
            </p>
        {% endif %}

        <div id="cg-results">
            {% for group, components in grouped %}
                {% set meta = groupMeta[group] ?? null %}
                <section class="cg-group" data-group="{{ group }}">
                    <h2 class="cg-group__title">{{ group }}</h2>
                    {% if meta and meta.description %}
                        <p class="cg-group__desc light">{{ meta.description }}</p>
                    {% endif %}
                    <ul class="cg-grid">
                        {% for component in components %}
                            {% set search = [component.title, component.name, group, component.templatePath, component.status, component.description, component.isDocumented ? '' : 'undocumented']|join(' ')|lower %}
                            {% set statusBucket = not component.isDocumented ? '__nostory' : (component.status ?: '__nostatus') %}
                            <li class="cg-card" id="cg-card-{{ component.id }}" data-card data-search="{{ search }}"
                                data-card-status="{{ statusBucket }}">
                                {% if not component.isDocumented %}
                                    {# Story-less template discovered via a marker file: no detail
                                       page or preview yet — an inert card with a hint instead. #}
                                    <div class="cg-card__link cg-card__link--undocumented">
                                        <span class="cg-card__title">{{ component.title }}</span>
                                        <span class="cg-card__meta code">{{ component.templatePath }}</span>
                                        <span class="cg-card__meta light">
                                            <span class="cg-chip cg-chip--status cg-chip--undocumented">{{ "undocumented"|t('component-guide') }}</span>
                                            {% if entryTypeNames[component.id] is defined %}
                                                {# This one is already a block editors can add — it just
                                                   arrives as an empty card. A story is worth more here. #}
                                                {{ "Add a story file for previews here, and a preview card in the editors' gallery."|t('component-guide') }}
                                            {% else %}
                                                {{ "Add a story file to unlock previews."|t('component-guide') }}
                                            {% endif %}
                                        </span>
                                        {% if canScaffold %}
                                            {# Writes into templates/, hence gated on allowAdminChanges
                                               (the controller enforces the same gate). The second
                                               submit appears only where the template actually has
                                               states worth splitting into separate stories. #}
                                            <form method="post" accept-charset="UTF-8" style="margin-top: 10px;">
                                                {{ csrfInput() }}
                                                {{ actionInput('component-guide/components/scaffold') }}
                                                {{ hiddenInput('componentId', component.id) }}
                                                <button type="submit" class="btn small"
                                                        title="{{ "Write one story with guessed args"|t('component-guide') }}">
                                                    {{ "Add story"|t('component-guide') }}
                                                </button>
                                                {% set states = statesByComponent[component.id] ?? null %}
                                                {% if states and states.values|length > 1 %}
                                                    <button type="submit" name="states" value="1" class="btn small"
                                                            title="{{ "Write one story per {var} value: {values}"|t('component-guide', {
                                                                var: states.var,
                                                                values: states.values|join(', '),
                                                            }) }}">
                                                        {{ "Add {count} stories"|t('component-guide', { count: states.values|length }) }}
                                                    </button>
                                                {% endif %}
                                            </form>
                                        {% endif %}
                                    </div>
                                {% else %}
                                <div class="cg-card__link cg-card__link--interactive">
                                    {# The whole box stays one big click target, but as an
                                       overlay link rather than a wrapper: a <button> inside
                                       an <a> is invalid HTML and would navigate on click.
                                       Everything below sits above the overlay. #}
                                    <a class="cg-card__hit" href="{{ cpUrl('component-guide/components/' ~ component.id) }}"
                                       aria-label="{{ component.title }}"></a>
                                    <span class="cg-card__title">
                                        {{ component.title }}
                                        {% if component.hasErrors %}
                                            {# Surface the actual problems right on the card (native tooltip). #}
                                            {% set errorText = component.errors|map(e => e.message ~ (e.recommendation() ? ' ' ~ e.recommendation() : ''))|join("\n") %}
                                            <span class="cg-badge cg-badge--error" title="{{ errorText }}">!</span>
                                        {% endif %}
                                        {# A scan error is a broken story file; this one is a template that
                                           threw while rendering, which the server cannot know here — the
                                           thumbnail frame reports it. Always in the DOM so JS only flips
                                           `hidden` and never composes a sentence. Only a hard error lights
                                           it: “rendered nothing” is a legitimate state for a component
                                           whose guards are doing their job, and a badge that cries wolf
                                           stops being read. #}
                                        <span class="cg-badge cg-badge--error" data-cg-render-badge hidden>!</span>
                                        {% set contract = contractErrors[component.id] ?? [] %}
                                        {% if contract %}
                                            {# Deliberately not the error badge. Nothing here is broken: the
                                               story renders, the names match, the page loads. What is wrong
                                               is that the card promises something the editor has no field to
                                               produce — so it reads as a mismatch, not a failure. #}
                                            {% set contractText = contract|map(e => e.message ~ (e.recommendation() ? ' ' ~ e.recommendation() : ''))|join("\n") %}
                                            <span class="cg-badge cg-badge--contract" title="{{ contractText }}">&ne;</span>
                                        {% endif %}
                                    </span>
                                    {% if component.description %}
                                        <span class="cg-card__desc light">{{ component.description }}</span>
                                    {% endif %}
                                    {% set previewUrl = previewUrls[component.id] ?? null %}
                                    <span class="cg-card__thumb" data-cg-thumb aria-hidden="true">
                                        {% if previewUrl %}
                                            {# Live mini-preview of the first story: a real 1280px-viewport
                                               iframe scaled down by JS (fixed px on the iframe, scale on its
                                               transform — same technique as the device preview). #}
                                            <iframe src="{{ previewUrl }}"
                                                    loading="lazy" tabindex="-1"
                                                    title=""></iframe>
                                        {% endif %}
                                    </span>
                                    <span class="cg-card__meta code">{{ component.templatePath }}</span>
                                    <span class="cg-card__meta light">
                                        {{ component.storyCount }} {{ (component.storyCount == 1 ? "story" : "stories")|t('component-guide') }}
                                        {% if component.status %}
                                            <span class="cg-chip cg-chip--status cg-chip--{{ component.status|lower|replace({' ': '-'}) }}"
                                                  data-cg-status-chip>{{ component.status }}</span>
                                        {% endif %}
                                        {# Shown only for the components that actually made it across:
                                           matched, stable, documented. A non-stable status is deliberately
                                           disabled in the gallery, so it gets no chip. #}
                                        {% set entryTypeName = entryTypeNames[component.id] ?? null %}
                                        <span data-cg-gallery-chip{% if not (entryTypeName and (component.status is empty or component.status == 'stable')) %} hidden{% endif %}>
                                            <span class="cg-chip cg-chip--gallery"
                                                  title="{{ entryTypeName
                                                      ? "Editors add this as the “{name}” block, from the blocks gallery on any page-builder field."|t('component-guide', { name: entryTypeName })
                                                      : '' }}">
                                                {{ "in gallery"|t('component-guide') }}
                                            </span>
                                        </span>
                                    </span>
                                    {# draft ⇄ stable, and only that: a review verdict on a
                                       story, not a lifecycle decision — beta and deprecated
                                       stay in the IDE. Same write gate as “Add story”, and
                                       every flip is journalled. Posts over fetch: a reviewer
                                       is halfway down a list of forty, and a page reload
                                       would send them back to the top every time. #}
                                    {% if canToggleStatus and component.status in ['draft', 'stable'] %}
                                        <span class="cg-card__actions">
                                            <button type="button" class="btn small"
                                                    data-cg-status-toggle
                                                    data-component-id="{{ component.id }}"
                                                    data-status="{{ component.status }}"
                                                    data-label-stable="{{ "Mark stable"|t('component-guide') }}"
                                                    data-label-draft="{{ "Back to draft"|t('component-guide') }}">
                                                {{ component.status == 'draft'
                                                    ? "Mark stable"|t('component-guide')
                                                    : "Back to draft"|t('component-guide') }}
                                            </button>
                                        </span>
                                    {% endif %}
                                </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}

            <div id="cg-no-results" class="cg-empty zilch hidden">
                <p>{{ "No components match the current filters."|t('component-guide') }}</p>
            </div>
        </div>
    {% endif %}
{% endblock %}
